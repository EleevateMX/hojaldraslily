node_modules/
dist/
# ...menos el paquete del agente de tickets. Va versionado porque el
# instalador baja un zip del repo y en la PC de la tienda no hay monorepo ni
# empaquetador, y ese agente importa `@lily/ui/papel` (que no existe en npm).
# Lo mantiene al dia una prueba: apps/agente-caja/src/render.test.ts.
!apps/agente-caja/dist/
!apps/agente-caja/dist/**
build/
*.local

# variables de entorno: NUNCA subir claves
.env
.env.*
!.env.example

# reportes generados por el ETL
supabase/seed/reportes/

.DS_Store
*.log

# Respaldos de costosshake: llevan costos de compra, proveedores y margenes.
# Este repositorio es publico — no entran aqui ni por accidente.
respaldo-costosshake-*.json

# La app nativa se REGENERA, no se versiona. El proyecto de Xcode y el de
# Android salen de capacitor.config.ts + scripts/app-nativa-preparar.sh en
# cada compilacion. Versionarlos invita a arreglar algo a mano en Xcode y
# perderlo en el siguiente `cap sync`, sin ningun error que lo delate.
apps/cliente-pwa/ios/
apps/cliente-pwa/android/

# Artefactos de build publicados en GitHub Pages (los compila el workflow)
demo/app/

# Capturas para enseñarle el sistema al negocio: se regeneran cuando hacen falta.
muestras/

# Las fuentes de la marca para el banco de pruebas: se bajan cuando hacen falta
# (ver apps/pos/mirar/ticket.html). No se versionan.
apps/pos/public/fuentes/
apps/pos/mirar/fuentes/

# Los instaladores que Admin sirve: se copian en cada build desde scripts/.
apps/admin/public/descargas/

# El agente de Banorte se instala con npm en la PC de la tienda; su lock de
# npm no va al repo (aqui mandamos con pnpm, como el agente de tickets).
apps/agente-banorte/package-lock.json
