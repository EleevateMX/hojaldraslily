{
  "name": "hojaldraslily-pos-ecosistema",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ecosistema POS + Costos de Hojaldras Lily sobre Supabase",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:costos": "pnpm --filter @lily/costos dev",
    "dev:pos": "pnpm --filter @lily/pos dev",
    "dev:kiosko": "pnpm --filter @lily/kiosko dev",
    "dev:admin": "pnpm --filter @lily/admin dev",
    "dev:produccion": "pnpm --filter @lily/produccion dev",
    "dev:horno": "pnpm --filter @lily/horno dev",
    "dev:empaque": "pnpm --filter @lily/empaque dev",
    "dev:display": "pnpm --filter @lily/cliente-display dev",
    "dev:web": "pnpm --filter @lily/web dev",
    "build": "pnpm -r --if-present build",
    "build:costos": "pnpm --filter @lily/costos build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "test:integration": "echo 'Sin suite de integración automatizada todavía — ver docs/auditoria-produccion.md §7 (deuda técnica) y las pruebas SQL documentadas en docs/checklist-produccion.md.' && exit 0",
    "test:e2e": "echo 'Sin suite e2e automatizada todavía — ver docs/auditoria-produccion.md §7.' && exit 0",
    "scripts:ascii": "node scripts/verificar-scripts-ascii.mjs",
    "audit:production": "pnpm lint && pnpm typecheck && pnpm test && pnpm scripts:ascii && pnpm build",
    "etl:dry": "pnpm --filter @lily/seed migrar -- --dry-run",
    "etl:aplicar": "pnpm --filter @lily/seed migrar -- --aplicar"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "typescript-eslint": "^8.15.0"
  }
}
