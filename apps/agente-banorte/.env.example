# Agente de Banorte por DLL — configuración.
# Copia este archivo a ".env" y llena los valores. NO subas el .env al repo.

# Ruta al DLL de Banorte. El kit trae DOS: Pinpad.dll (64 bits, el normal) y
# Pinpad.tpv (32 bits). Usa el .dll con Node normal (x64). Si tu Node es de 32
# bits, cambia a ./Pinpad.tpv. Déjalo junto a este programa.
DLL_PATH=./Pinpad.dll

# Cómo se conecta a la pinpad. La Verifone V660p va por RED (WiFi): pon su IP
# de la red local y el puerto 1818 (el de fábrica). Mira la IP en la propia
# pinpad: menú Configurar -> Reporte de parámetros (clave 86279).
PINPAD_IP=192.168.0.50
PINPAD_PORT=1818
# Si en vez de red fuera por cable serial, deja PINPAD_IP vacío y usa:
# PINPAD_COM=COM3

# Credenciales de Payworks (el "usuario motor"): las que dio Banorte.
PAYWORKS_USER=Terminal
PAYWORKS_PASSWORD=
PAYWORKS_GROUP=

# Modo. AUT = simulación aprobada, NO cobra (para probar). PRD = cobra de
# verdad. Empieza en AUT; pásalo a PRD solo cuando la prueba salga bien.
PAYWORKS_MODE=AUT

# Cómo lee los resultados del DLL. El DLL trae las dos familias (verificado):
# "return" usa los PPGet* que devuelven el texto (por defecto, el más directo);
# si algún campo saliera vacío, cambia a "buffer" (usa los PPVBGet*).
GETTER_STYLE=return

# Segundos que espera la pinpad por la tarjeta.
TIMEOUT=90

# Puerto del servidor local (solo para pruebas en la misma red).
PUERTO_HTTP=8099
