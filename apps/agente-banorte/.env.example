# Agente de Banorte por DLL — configuración.
# Copia este archivo a ".env" y llena los valores. NO subas el .env al repo.

# Ruta al DLL de Banorte. El kit trae DOS: Pinpad.dll (64 bits, el normal) y
# Pinpad.tpv (32 bits). Usa el .dll con Node normal (x64). Si tu Node es de 32
# bits, cambia a ./Pinpad.tpv. Déjalo junto a este programa.
DLL_PATH=./Pinpad.dll

# Cómo se conecta a la pinpad. La Verifone V660p va por RED (WiFi): pon su IP
# de la red local y el puerto 1818 (el de fábrica). Mira la IP en la propia
# pinpad: botón verde x2 -> 1 Configurar (clave 26813) -> 3 Reporte de
# parámetros (clave 86279); ahí aparece la IP.
PINPAD_IP=192.168.0.50
PINPAD_PORT=1818
# Si en vez de red fuera por cable serial, deja PINPAD_IP vacío y usa:
# PINPAD_COM=COM3

# Credenciales de Payworks (el "usuario motor"): las que dio Banorte. El de
# PRODUCCIÓN es el usuario de SOLO EJECUCIÓN (TERMINAL), creado desde el usuario
# administrador. OJO: el usuario es SENSIBLE A MAYÚSCULAS y tiene que ir EXACTO
# como lo creó Banorte — en la carta de certificación aparece como "TERMINAL".
# Si no coincide (p. ej. "Terminal" vs "TERMINAL"), la autenticación falla y la
# pinpad dice que "las llaves no son".
PAYWORKS_USER=TERMINAL
PAYWORKS_PASSWORD=
PAYWORKS_GROUP=

# Modo. AUT = simulación aprobada, NO cobra (para probar). PRD = cobra de
# verdad. IMPORTANTE: la LLAVE que se inyecta a la pinpad (OBTENER_LLAVE) queda
# atada al modo — una llave cargada en AUT (prueba) NO sirve para cobrar en PRD
# y viceversa. En la TIENDA va SIEMPRE en PRD; si cambias de modo, vuelve a
# cargar la llave (node index.mjs llave) en ese modo.
PAYWORKS_MODE=PRD

# Cómo lee los resultados del DLL. El DLL trae las dos familias (verificado):
# "return" usa los PPGet* que devuelven el texto (por defecto, el más directo);
# si algún campo saliera vacío, cambia a "buffer" (usa los PPVBGet*).
GETTER_STYLE=return

# Segundos que espera la pinpad por la tarjeta.
TIMEOUT=90

# Puerto del servidor local (solo para pruebas en la misma red).
PUERTO_HTTP=8099

# --- Modo COLA (producción: `node index.mjs cola`) ---
# La caja (en la nube) encola los cobros y este agente los toma por aquí. No
# expone ningún puerto. El token sale de Admin -> Terminal -> "Conectar la
# terminal". SUPABASE_URL y SUPABASE_ANON_KEY son los del proyecto (la llave
# publicable es pública por diseño).
SUPABASE_URL=https://fzkdgqqvfkogmxdgqsxj.supabase.co
SUPABASE_ANON_KEY=
TERMINAL_TOKEN=
AGENTE_ID=agente-banorte-01
COLA_POLL_SEGUNDOS=3
COLA_LATIDO_SEGUNDOS=30
