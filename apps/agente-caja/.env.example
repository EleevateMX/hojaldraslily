# La PC de la tienda. Copia este archivo a .env y llenalo.
# La llave anon es publica por diseno; el token de la impresora NO.
SUPABASE_URL=https://fzkdgqqvfkogmxdgqsxj.supabase.co
SUPABASE_ANON_KEY=

# El token sale de Admin -> Impresoras, en el renglon de la de caja.
IMPRESORA_TOKEN=

# --- Cómo imprime: elige UNA de las dos ---
#
# A) USB / impresora de Windows (p. ej. una POS-58 colgada por USB). Pon el
#    NOMBRE EXACTO con que aparece en Windows (Configuración -> Impresoras).
#    Si pones esto, IMPRESORA_HOST ya no hace falta.
IMPRESORA_WINDOWS=POS-58
#
# B) Red (térmica con IP, puerto 9100). Deja IMPRESORA_WINDOWS vacío y usa:
# IMPRESORA_HOST=192.168.1.50
# IMPRESORA_PUERTO=9100

# 58mm (la POS-58) o 80mm. Equivocarse NO da error: el ticket sale desalineado.
IMPRESORA_ANCHO=58mm

# Copias del ticket de venta: 2 = original para el cliente + copia (lo pidió
# la casa). El corte y las pruebas salen una sola vez.
TICKET_COPIAS=2

AGENTE_ID=agente-caja-01
POLL_INTERVALO_SEGUNDOS=3
LATIDO_INTERVALO_SEGUNDOS=30
